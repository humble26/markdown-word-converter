{
  "name": "markdown-word-converter",
  "version": "1.4.1",
  "description": "将 AI 回复的 Markdown 一键转换为带格式的富文本，粘贴到 Word 后样式完整保留；可导出 .docx / .doc / .tex，并支持拖入文件自动识别类型反向转换。",
  "main": "main.js",
  "author": "Markdown2Word",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/humble26/markdown-word-converter.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test tests/main-security.test.js tests/texconv.test.js tests/texconv-doc.test.js tests/math-pipeline.test.js tests/docxread.test.js tests/page-smoke.test.js"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.markdown2word.converter",
    "productName": "Markdown-Word转换器",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown-Word转换器"
    }
  }
}